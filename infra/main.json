{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "REPLACE-WITH-YOUR-APP-NAME",
      "metadata": { "description": "Globally unique web app name (lowercase letters, numbers, hyphens)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "skuName": {
      "type": "string",
      "defaultValue": "F1",
      "allowedValues": [ "F1", "B1" ],
      "metadata": { "description": "F1 is the free tier. Use B1 if F1 is not available to you." }
    }
  },
  "variables": {
    "planName": "[concat('plan-', parameters('appName'))]",
    "tags": {
      "project": "cicd-demo",
      "env": "dev",
      "managedBy": "github-actions"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "linux",
      "sku": { "name": "[parameters('skuName')]" },
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|24-lts",
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled"
        }
      }
    }
  ],
  "outputs": {
    "appHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName'))).defaultHostName]"
    }
  }
}
